+// isLoopbackHost reports whether the Host header is a legitimate local
+// value for this gateway: "localhost" or "127.0.0.1", with any port.
+// IPv6 loopback is deliberately excluded until a real caller requires it.
+func isLoopbackHost(hostport string) bool {
+	host := hostport
+	if i := strings.LastIndexByte(hostport, ':'); i > 0 {
+		host = hostport[:i]
+	}
+	host = strings.TrimSuffix(strings.TrimPrefix(host, "["), "]")
+	return host == "localhost" || host == "127.0.0.1"
+}

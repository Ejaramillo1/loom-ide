 		// Check if origin is allowed
 		allowedOrigin := h.getAllowedOrigin(origin)
+
+		// Browser-origin requests outside the allowlist are refused
+		// before dispatch. Omitting Access-Control-Allow-Origin only
+		// hides the response from the browser; it does not stop a
+		// "simple" request (no preflight) from executing an action —
+		// proven by the isolated matrix (session created via a
+		// text/plain POST with an unlisted Origin, no ACAO).
+		// Requests without an Origin header (native clients, curl,
+		// the IDE's Rust client) are not cross-origin browser
+		// requests and pass through unchanged.
+		if origin != "" && allowedOrigin == "" {
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusForbidden)
+			_, _ = w.Write([]byte(`{"error":{"code":7,"message":"origin not allowed"}}`))
+			return
+		}
+
 		if allowedOrigin != "" {
 			w.Header().Set("Access-Control-Allow-Origin", allowedOrigin)
 		}
